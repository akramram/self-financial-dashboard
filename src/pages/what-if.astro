---
import Layout from '../layouts/Layout.astro';
import WhatIfPlanner from '../components/WhatIfPlanner';
---

<Layout title="What-If Scenario Hub - Financial Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">What-If Scenario Intelligence Hub</h1>
    <p class="text-slate-600 dark:text-slate-400 text-sm mt-1">
      Simulasikan perubahan pendapatan, pemangkasan kategori, imbal hasil majemuk, dan pengeluaran satu kali untuk melihat dampaknya terhadap kekayaan bersih serta target finansial Anda.
    </p>
  </div>

  <WhatIfPlanner client:load />
</Layout>
