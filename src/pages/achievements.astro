---
import Layout from '../layouts/Layout.astro';
import Achievements from '../components/Achievements';
---

<Layout title="Achievements & Milestones - Financial Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
      <span>🏆</span> Achievements & Milestones
    </h1>
    <p class="text-slate-600 dark:text-white/50 text-sm">
      Rayakan progres finansial, tonggak pencapaian kekayaan bersih, konsistensi tabungan, dan lencana kedisiplinan keuangan Anda.
    </p>
  </div>

  <Achievements client:load />
</Layout>
