---
import Layout from '../layouts/Layout.astro';
import SavingsRateTracker from '../components/SavingsRateTracker';
---

<Layout title="Savings Rate Intelligence Hub - Financial Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
      Savings Rate Intelligence Hub
    </h1>
    <p class="text-slate-600 dark:text-white/60 text-sm mt-1">
      Analisis tingkat tabungan per siklus gaji, dekomposisi Investasi vs Surplus Kas, tolok ukur pencapaian, dan simulator target tabungan.
    </p>
  </div>

  <SavingsRateTracker client:load />
</Layout>
