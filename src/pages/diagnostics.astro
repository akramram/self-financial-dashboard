---
import Layout from '../layouts/Layout.astro';
import DataHealthHub from '../components/DataHealthHub';
---

<Layout title="Data Health - Financial Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Data Health</h1>
    <p class="text-slate-600 dark:text-white/50 text-sm">
      Pemeriksaan integritas database: anomali periode, tanggal, tipe transaksi, dan kategori.
    </p>
  </div>

  <DataHealthHub client:load />
</Layout>
