---
import Layout from '../layouts/Layout.astro';
import FlowMapHub from '../components/FlowMapHub';
---

<Layout title="Money Flow: Financial Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">Money Flow</h1>
    <p class="text-slate-600 dark:text-white/50 text-sm">
      Peta aliran dana satu periode: dari pemasukan ke setiap peruntukan, dengan porsi kredit, investasi, dan sisa tabungan dalam satu diagram Sankey.
    </p>
  </div>

  <FlowMapHub client:load />
</Layout>
