---
import Layout from '../layouts/Layout.astro';
import AddTransactionForm from '../components/AddTransactionForm';
import AddNetworthForm from '../components/AddNetworthForm';
---

<Layout title="Add Data">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">Add Data</h1>
    <p class="text-slate-500 dark:text-slate-400 text-sm">Add new transactions or update networth</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
      <h2 class="text-lg font-semibold mb-4">Add Transaction</h2>
      <AddTransactionForm client:load />
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
      <h2 class="text-lg font-semibold mb-4">Add / Update Networth</h2>
      <AddNetworthForm client:load />
    </div>
  </div>

  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
    <h2 class="text-lg font-semibold mb-4">Data Management</h2>
    <div class="flex flex-col sm:flex-row gap-3">
      <a
        href="/api/export"
        class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition text-center"
      >
        Export All Data (JSON)
      </a>
    </div>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-3">
      Data is stored in a local SQLite database. Export to back up your changes.
    </p>
  </div>
</Layout>
