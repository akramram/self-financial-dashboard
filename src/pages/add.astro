---
import Layout from '../layouts/Layout.astro';
import AddTransactionForm from '../components/AddTransactionForm';
import AddNetworthForm from '../components/AddNetworthForm';
import { Button } from '../components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../components/ui/card';
---

<Layout title="Add Data">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">Add Data</h1>
    <p class="text-slate-500 dark:text-slate-400 text-sm">Add new transactions or update networth</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <AddTransactionForm client:load />
    <AddNetworthForm client:load />
  </div>

  <Card>
    <CardHeader>
      <CardTitle>Data Management</CardTitle>
      <CardDescription>Export or back up your financial data</CardDescription>
    </CardHeader>
    <CardContent>
      <div class="flex flex-col sm:flex-row gap-3">
        <Button asChild>
          <a href="/api/export">Export All Data (JSON)</a>
        </Button>
      </div>
      <p class="text-xs text-muted-foreground mt-3">
        Data is stored in a local SQLite database. Export to back up your changes.
      </p>
    </CardContent>
  </Card>
</Layout>
