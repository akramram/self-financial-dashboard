---
import Layout from '../layouts/Layout.astro';
import YearlyReport from '../components/YearlyReport';
import { getMonthlySummary, getCategories, db } from '../lib/db';

const summaries = getMonthlySummary();
const categories = getCategories();

// Enrich summaries with income from DB
const incomeRows = db.prepare('SELECT month, income FROM monthly_income').all() as any[];
const incomeMap = new Map(incomeRows.map((r) => [r.month, r.income]));
for (const s of summaries) {
  const income = incomeMap.get(s.month) || 0;
  s.income = income;
  s.savings = income - s.outcome.total;
  s.savings_rate_pct = income > 0 ? Number(((s.savings / income) * 100).toFixed(2)) : 0;
}
---

<Layout title="Yearly Report - Financial Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">Yearly Report</h1>
    <p class="text-slate-500 dark:text-slate-400 text-sm">
      Annual aggregates, year-over-year trends, and spending breakdowns by year.
    </p>
  </div>

  <YearlyReport
    summaries={summaries}
    categories={categories}
    client:load
  />
</Layout>
