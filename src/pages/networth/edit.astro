---
import Layout from '../../layouts/Layout.astro';
import NetworthEditForm from '../../components/NetworthEditForm';
---

<Layout title="Edit Networth">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">Edit Networth</h1>
    <p class="text-slate-500 dark:text-slate-400 text-sm">Modify the investment breakdown for a month</p>
  </div>

  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
    <NetworthEditForm client:load />
  </div>
</Layout>
