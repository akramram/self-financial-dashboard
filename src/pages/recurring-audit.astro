---
import Layout from '../layouts/Layout.astro';
import RecurringCostAnalyzer from '../components/RecurringCostAnalyzer';
---

<Layout title="Recurring & Subscription Intelligence Hub - Financial Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold flex items-center gap-2 text-slate-900 dark:text-white">
      <span>🔄</span> Recurring & Subscription Intelligence Hub
    </h1>
    <p class="text-slate-600 dark:text-white/50 text-sm">
      Audit komitmen rutin bulanan, deteksi kebocoran kas langganan, dan simulasi dampak pemangkasan kekayaan majemuk.
    </p>
  </div>

  <RecurringCostAnalyzer client:load />
</Layout>
