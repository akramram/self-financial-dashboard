---
import Layout from '../layouts/Layout.astro';
import HealthScore from '../components/HealthScore';
---

<Layout title="Financial Health Intelligence Hub - Financial Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
      Financial Health Intelligence Hub
    </h1>
    <p class="text-slate-600 dark:text-white/60 text-sm mt-1">
      Skor komposit 5 pilar kesehatan finansial (0-100), radar perbandingan antar siklus gaji, simulator What-If kenaikan skor, dan rencana aksi prioritas.
    </p>
  </div>

  <HealthScore client:load />
</Layout>
