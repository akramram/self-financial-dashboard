---
import Layout from '../layouts/Layout.astro';
import SpendingCalendar from '../components/SpendingCalendar';
import { getTransactions, getAllPeriods } from '../lib/db';

const transactions = getTransactions();
const periods = getAllPeriods().map((p: any) => ({ period_id: p.id, month: p.month }));
---

<Layout title="Spending Calendar - Financial Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">Spending Calendar</h1>
    <p class="text-slate-500 dark:text-slate-400 text-sm">
      Visualize daily spending intensity and drill down into individual days
    </p>
  </div>

  <SpendingCalendar
    transactions={transactions}
    periods={periods}
    client:load
  />
</Layout>
