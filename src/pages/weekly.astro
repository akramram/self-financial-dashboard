---
import Layout from '../layouts/Layout.astro';
import WeeklyTracker from '../components/WeeklyTracker';
---

<Layout title="Weekly Spending & Pacing Intelligence - Financial Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
      <span>📅</span> Weekly Spending & Pacing Intelligence Hub
    </h1>
    <p class="text-slate-600 dark:text-white/50 text-sm">
      Monitor ritme pengeluaran mingguan, kurva kumulatif burn-rate, kalkulator Safe-to-Spend harian, dan audit transaksi akhir pekan vs hari kerja.
    </p>
  </div>

  <WeeklyTracker client:load />
</Layout>
