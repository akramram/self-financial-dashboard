---
import Layout from '../layouts/Layout.astro';
import MonthComparison from '../components/MonthComparison';
---

<Layout title="Compare Months - Financial Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">Compare Months</h1>
    <p class="text-slate-600 dark:text-white/50 text-sm">
      Komparasi mendalam dua periode siklus gaji: variansi pengeluaran, pergeseran kategori, driver lonjakan biaya, dan rincian transaksi side-by-side.
    </p>
  </div>

  <MonthComparison client:load />
</Layout>
