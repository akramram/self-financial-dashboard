---
import Layout from '../layouts/Layout.astro';
import NetworthChart from '../components/NetworthChart';
import NetworthComposition from '../components/NetworthComposition';
import NetworthTable from '../components/NetworthTable';
import NetworthProjection from '../components/NetworthProjection';
import { getNetworth } from '../lib/db';

const networth = getNetworth();
const networthReversed = [...networth].reverse();
---

<Layout title="Networth">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">Networth</h1>
    <p class="text-slate-600 dark:text-white/60 text-sm">Assets and investments over time</p>
  </div>

  <!-- Networth Trend Line Chart -->
  <div class="glass-card p-6 mb-6">
    <h2 class="text-lg font-semibold mb-4">Networth Trend</h2>
    <NetworthChart data={networth} client:load />
  </div>

  <!-- Net Worth Projection -->
  <NetworthProjection data={networth} client:load />

  <!-- Portfolio Composition (Donut + Metrics + Stacked Bar) -->
  <NetworthComposition data={networth} client:load />

  <!-- Monthly History Table -->
  <div class="mt-6 glass-card overflow-hidden">
    <div class="p-6 border-b border-slate-200 dark:border-white/[0.06]">
      <h2 class="text-lg font-semibold">Monthly History</h2>
    </div>
    <div class="overflow-x-auto">
      <NetworthTable networth={networth} client:load />
    </div>
  </div>
</Layout>
