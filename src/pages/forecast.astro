---
import Layout from '../layouts/Layout.astro';
import Forecast from '../components/Forecast';
---

<Layout title="Predictive Financial Intelligence Hub - Financial Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
      Predictive Financial Intelligence Hub
    </h1>
    <p class="text-slate-600 dark:text-white/60 text-sm mt-1">
      Proyeksi akhir bulan multi-model, simulator batas belanja harian aman, estimasi laju tabungan EOM, deteksi kejenuhan anggaran, dan simulasi koreksi arah.
    </p>
  </div>

  <Forecast client:load />
</Layout>
