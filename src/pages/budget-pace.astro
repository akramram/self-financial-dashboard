---
import Layout from '../layouts/Layout.astro';
import BudgetPace from '../components/BudgetPace';
---

<Layout title="Budget Pace & Burn-Rate Tracker - Financial Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
      ⚡ Budget Pace & Burn-Rate Tracker
    </h1>
    <p class="text-slate-600 dark:text-white/50 text-sm">
      Pantau kecepatan belanja harian (burn rate), sisa alokasi pengeluaran aman, dan proyeksi deviasi anggaran dalam siklus gaji.
    </p>
  </div>

  <BudgetPace client:load />
</Layout>
